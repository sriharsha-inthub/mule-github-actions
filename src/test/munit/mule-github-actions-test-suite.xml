<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit" xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools  http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">
	<munit:config name="mule-github-actions-test-suite.xml" />
	<munit:test name="mule-github-actions-test-suite-mule-github-actionsFlowTest" doc:id="ddd7f359-960b-4ef1-9eba-00d29b9858a2" description="Test">
		<munit:behavior >
			<munit-tools:mock-when doc:name="Mock when" doc:id="fab10186-9f44-45d6-a700-ef9caf3d0c6c" processor="http:listener">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="HTTP_Listener_config" attributeName="config-ref" />
					<munit-tools:with-attribute whereValue="/test" attributeName="path" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:attributes value='#[{method: "GET", requestUri : "/test"}]' />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:spy doc:name="Spy" doc:id="6777ade2-b007-48d9-858b-b35843d7367c" processor="ee:transform">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="Transform Message" attributeName="doc:name" />
					<munit-tools:with-attribute whereValue="9d5a392e-4bd3-41d1-929e-bfa0ed3c99d3" attributeName="doc:id" />
				</munit-tools:with-attributes>
			</munit-tools:spy>
		</munit:behavior>
		<munit:execution >
			<flow-ref doc:name="Flow-ref to mule-github-actionsFlow" doc:id="c1c1f6da-c8d4-4324-96c1-ac94501acd61" name="mule-github-actionsFlow"/>
		</munit:execution>
		<munit:validation >
			<munit-tools:verify-call doc:name="Verify call" doc:id="2239c4bf-2874-4eee-84d1-01f4478bb09c" processor="logger" times="1">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="INFO" attributeName="level" />
					<munit-tools:with-attribute whereValue="Logger" attributeName="doc:name" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>


</mule>
